[Desktop Entry]
Name=Porthole
GenericName=Remote Desktop Client
Comment=Connect to Windows PCs and virtual desktops
Keywords=RDP;Remote;Desktop;Windows;
Exec=porthole %U
Icon=io.github.porthole.Porthole
Terminal=false
Type=Application
Categories=Network;RemoteAccess;GTK;
MimeType=application/x-rdp;x-scheme-handler/rdp;x-scheme-handler/ms-rd;
StartupNotify=true
